{
  "name": "mailloom",
  "version": "1.0.0",
  "private": true,
  "description": "Lightweight modern webmail client for Delpat iRedMail infrastructure, replacing Roundcube",
  "scripts": {
    "dev": "concurrently \"pnpm --filter mailloom-server dev\" \"pnpm --filter mailloom-client dev\"",
    "build": "pnpm --filter mailloom-server build && pnpm --filter mailloom-client build",
    "start": "pnpm --filter mailloom-server start",
    "test": "pnpm --filter mailloom-server test",
    "dev:server": "pnpm --filter mailloom-server dev",
    "dev:client": "pnpm --filter mailloom-client dev",
    "release": "node scripts/release.mjs",
    "test:deploy": "node --test scripts/test/update-decide.test.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "esbuild": "^0.28.2"
  },
  "type": "module"
}
