# Mailloom server configuration. Copy to .env next to the server and fill in.
# Never commit a filled-in copy. The server refuses to start if a required value is missing.
NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# REQUIRED. Encrypts the mail passwords held in server-side sessions (at least 32 characters).
# Generate a fresh value per server:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out.
SESSION_SECRET=

# Where sessions are stored (node:sqlite file, keep it outside the web root, mode 600).
# Leave empty to keep sessions in memory only (everyone is signed out on restart).
SESSION_DB_PATH=/var/lib/mailloom/sessions.db

# Session lifetimes: without "Remember me" a session ends after this many idle minutes
# (and at most SESSION_SHORT_MAX_HOURS after sign-in); with it, after SESSION_REMEMBER_DAYS.
SESSION_IDLE_MINUTES=30
SESSION_SHORT_MAX_HOURS=12
SESSION_REMEMBER_DAYS=30
# Remember Me sessions also end this many days after sign-in, however much they are used.
SESSION_REMEMBER_MAX_DAYS=180

# REQUIRED. The mail server. Users cannot choose it; it is fixed here.
MAIL_IMAP_HOST=127.0.0.1
MAIL_IMAP_PORT=993
MAIL_IMAP_SECURE=true
MAIL_SMTP_HOST=127.0.0.1
MAIL_SMTP_PORT=587
# Certificate name to check when connecting by IP (e.g. the server's mail hostname).
MAIL_TLS_SERVERNAME=
# Optional: PEM file of a self-signed mail certificate to trust (checks stay on), e.g. /etc/mailloom/mail-ca.pem
MAIL_TLS_CA_FILE=
# Certificate checks are on by default. Turning them off also needs MAIL_ALLOW_INSECURE_TLS=1
# and is meant for local test servers only.
MAIL_TLS_REJECT_UNAUTHORIZED=true

# REQUIRED. Only these mail domains may sign in (comma separated).
# Only domains whose mailboxes live on this iRedMail server belong here.
MAIL_DOMAINS=delpat.in,houseofhumanity.in

# SMTP must be encrypted (STARTTLS on 587, or implicit TLS on 465). Never set
# MAIL_SMTP_ALLOW_PLAIN=1 on a real server; it exists only for local test servers.
# Largest outgoing message in bytes (default 10 MB).
# MAIL_MAX_MESSAGE_BYTES=10485760

# Behind nginx on the same machine: trust it for the client IP (login throttling per IP) and for
# X-Forwarded-Proto. Give the proxy's IP address (a list is fine).
# If the agent API is on (AGENT_ALLOWED_IPS), always use the proxy IP list here, never a hop count:
# a hop count lets a caller who sends their own X-Forwarded-For pick the address that is checked.
# "true" is refused.
# nginx must send these headers (see the README deploy section):
#   proxy_set_header Host $host;                      # cookie and origin checks use the Host header
#   proxy_set_header X-Forwarded-For $remote_addr;    # the real visitor; never append to a client-sent value
#   proxy_set_header X-Forwarded-Host $host;
#   proxy_set_header X-Forwarded-Proto $scheme;       # sign-in over plain http is refused
TRUST_PROXY=127.0.0.1

# Always use Secure, __Host- prefixed cookies, whatever the Host header says.
COOKIE_SECURE=true

# Public address of Mailloom (https only). When set, agent API messages carry a web_url that opens them:
#   <MAILLOOM_PUBLIC_URL>/#/m/<url-encoded Message-ID>
# MAILLOOM_PUBLIC_URL=https://webmail.example.com

# Extra origins allowed to call the API from a browser (comma separated). Same origin needs nothing.
CORS_ORIGINS=

# Demo mailbox with sample data. Off unless set to 1.
DEMO_MODE=0

# Agent API (/api/agent/v1/*, used by Work OS with per-person keys from Mailloom > Connections).
# Comma list of IPs or CIDR ranges allowed to call it (the Work OS server). Empty = agent API off.
# The address checked is the client IP after TRUST_PROXY, so behind nginx list the real caller.
AGENT_ALLOWED_IPS=
# Runaway guards (generous on purpose): mails one key may send per rolling hour, recipients per mail.
# AGENT_SENDS_PER_HOUR=200
# AGENT_MAX_RECIPIENTS=100
# Largest message text (characters) and attachment (bytes) returned to the agent.
# AGENT_MAX_TEXT_CHARS=100000
# AGENT_MAX_ATTACHMENT_BYTES=10485760

# New-mail notifications while Mailloom is closed (Web Push; on iPhone only for the home-screen app).
# All three or none. None = only in-app notifications. Generate the pair once with:
#   npx web-push generate-vapid-keys
# Keep the private key secret and never change the pair: changing it stops every device's notifications.
# The server also needs outbound https to the browser push services (fcm.googleapis.com,
# *.push.services.mozilla.com, *.notify.windows.com, web.push.apple.com, *.push.apple.com).
# Mail that arrives while the server is down is not notified after it restarts (only mail arriving
# while it runs is). Rotating SESSION_SECRET stops every device's notifications without notice:
# the stored passwords can no longer be opened, so those devices are disabled and must turn them on again.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:it@delpat.in
