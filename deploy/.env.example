# Mailloom server configuration. Copy to .env next to the server and fill in.
# Never commit a filled-in copy. The server refuses to start if a required value is missing.
NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# REQUIRED. Encrypts the mail passwords held in server-side sessions (at least 32 characters).
# Generate a fresh value per server:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out.
SESSION_SECRET=

# Where sessions are stored (node:sqlite file, keep it outside the web root, mode 600).
# Leave empty to keep sessions in memory only (everyone is signed out on restart).
SESSION_DB_PATH=/var/lib/mailloom/sessions.db

# Session lifetimes: without "Remember me" a session ends after this many idle minutes
# (and at most SESSION_SHORT_MAX_HOURS after sign-in); with it, after SESSION_REMEMBER_DAYS.
SESSION_IDLE_MINUTES=30
SESSION_SHORT_MAX_HOURS=12
SESSION_REMEMBER_DAYS=30

# REQUIRED. The mail server. Users cannot choose it; it is fixed here.
MAIL_IMAP_HOST=127.0.0.1
MAIL_IMAP_PORT=993
MAIL_IMAP_SECURE=true
MAIL_SMTP_HOST=127.0.0.1
MAIL_SMTP_PORT=587
# Certificate name to check when connecting by IP (e.g. the server's mail hostname).
MAIL_TLS_SERVERNAME=
# Certificate checks are on by default. Turning them off also needs MAIL_ALLOW_INSECURE_TLS=1
# and is meant for local test servers only.
MAIL_TLS_REJECT_UNAUTHORIZED=true

# REQUIRED. Only these mail domains may sign in (comma separated).
MAIL_DOMAINS=delpat.in,houseofhumanity.in,ydco.in

# SMTP must be encrypted (STARTTLS on 587, or implicit TLS on 465). Never set
# MAIL_SMTP_ALLOW_PLAIN=1 on a real server; it exists only for local test servers.
# Largest outgoing message in bytes (default 10 MB).
# MAIL_MAX_MESSAGE_BYTES=10485760

# Behind nginx on the same machine: trust it for the client IP (login throttling per IP) and for
# X-Forwarded-Proto. Give the proxy's IP (or a hop count such as 1). "true" is refused.
# nginx must send these headers (see the README deploy section):
#   proxy_set_header Host $host;                      # cookie and origin checks use the Host header
#   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#   proxy_set_header X-Forwarded-Proto $scheme;       # sign-in over plain http is refused
TRUST_PROXY=127.0.0.1

# Always use Secure, __Host- prefixed cookies, whatever the Host header says.
COOKIE_SECURE=true

# Extra origins allowed to call the API from a browser (comma separated). Same origin needs nothing.
CORS_ORIGINS=

# Demo mailbox with sample data. Off unless set to 1.
DEMO_MODE=0
